# Lifevuww Environment Configuration
# Copy this file to .env and fill in your database credentials.

DB_HOST=localhost
DB_NAME=habit_tracker_rpg
DB_USERNAME=root
DB_PASSWORD=
APP_TIMEZONE=Asia/Jakarta

# Security & Cron settings
# Set to 'true' only if behind a verified reverse proxy or Cloudflare
TRUST_PROXY=false
# Secret token required to trigger /cron/daily_reset.php over HTTP
CRON_TOKEN=change_this_secret_token_in_production

# Login persistence (remember me)
# Masa berlaku cookie sesi & token remember-me dalam hari (default 30).
# Semakin besar, semakin lama APK/browser tetap login tanpa login ulang.
SESSION_LIFETIME_DAYS=30
# Batas idle hard-logout dalam detik; 0 = nonaktif (login hanya bergantung
# pada masa berlaku cookie & token di atas). Contoh lama: 1800 (30 menit).
SESSION_IDLE_TIMEOUT=0
