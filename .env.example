# Lifevuww Environment Configuration
# Copy this file to .env and fill in your database credentials.

DB_HOST=localhost
DB_NAME=habit_tracker_rpg
DB_USERNAME=root
DB_PASSWORD=
APP_TIMEZONE=Asia/Jakarta

# Security & Cron settings
# Set to 'true' only if behind a verified reverse proxy or Cloudflare
TRUST_PROXY=false
# Secret token required to trigger /cron/daily_reset.php over HTTP
CRON_TOKEN=change_this_secret_token_in_production
