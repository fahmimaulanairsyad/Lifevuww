# Disable directory browsing
Options -Indexes

# Protect sensitive environment and SQL files
<FilesMatch "^(\.env|\.git|database\.sql)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Set default charset
AddDefaultCharset UTF-8
